
# Copy this file to .env for local development
APP_ENV=development
ENABLE_DEV_PASSWORD_AUTH=true

# Database
DATABASE_URL=sqlite:///./hrms.db

# Production example: PostgreSQL
# DATABASE_URL=postgresql://user:password@host/database

# Application security
SECRET_KEY=generate-a-long-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=15
AUTH_SESSION_MAX_DAYS=7

# Frontend origin
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Allowed company email domains (comma-separated)
ALLOWED_EMAIL_DOMAINS=tesseractuk.in

# Google OAuth credentials
# Get these from Google Cloud Console > Google Auth Platform > Clients
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Session cookie settings for local development
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Attendance uses the company timezone and office geofence.
OFFICE_LATITUDE=22.72267583211552
OFFICE_LONGITUDE=75.88714542620116
OFFICE_GEOFENCE_RADIUS_METERS=500
MAX_GPS_ACCURACY_METERS=500

# Production: set APP_ENV=production, PostgreSQL, a strong SECRET_KEY, HTTPS
# frontend/API origins, Google credentials, COOKIE_SECURE=true, and
# COOKIE_SAMESITE=none in the deployment platform (see render.yaml).

# Outbound email. console = log only; smtp = send via SMTP (e.g. Google Workspace
# smtp.gmail.com:587 with an App Password for notifications@tesseractuk.in).
EMAIL_BACKEND=console
EMAIL_FROM=Tesseract HRMS <notifications@tesseractuk.in>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=notifications@tesseractuk.in
SMTP_PASSWORD=
