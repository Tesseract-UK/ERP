
# Copy this file to .env for local development

# Database
DATABASE_URL=sqlite:///./hrms.db

# Production example: PostgreSQL
# DATABASE_URL=postgresql://user:password@host/database

# Application security
SECRET_KEY=generate-a-long-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Frontend origin
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Allowed company email domains (comma-separated)
ALLOWED_EMAIL_DOMAINS=tesseractuk.in

# Google OAuth credentials
# Get these from Google Cloud Console > Google Auth Platform > Clients
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Session cookie settings for local development
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
